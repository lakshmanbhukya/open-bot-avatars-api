# Public origin for absolute Open Graph / Twitter image URLs at build time.
# Vercel detects its production domain automatically.
SITE_URL=http://localhost:3000

# Required on Vercel: a shared Upstash Redis database (server-only credentials).
# Leave both unset for the local, per-process limiter during development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# For another reverse proxy only: name a header it OVERWRITES with the client IP.
# Vercel automatically uses its trusted x-forwarded-for header.
# Without a trusted header, requests share one quota; arbitrary IP headers are ignored.
RATE_LIMIT_IP_HEADER=
